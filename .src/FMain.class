' Gambas class file

Public resul As Result
Public dDate As Date = Now

   

Public Sub cargar()

    t1.text = resul["id"]
     t2.text = resul["nom"]
      t3.text = resul["ape"]
       t4.Text = resul["ced"]
        t5.text = resul["cel"]
         t6.text = resul["dir"]
          t7.text = resul["ema"]
           t8.text = resul["dep"]
            t9.text = resul["deu"]
             t10.text = resul["fec"]
              t11.text = resul["nota"]
               vlbid.value = resul.Index + 1
    
End 


Public Sub Button6_Click()

  'resul = mod.cnx.Exec("select * from clientes order by id Asc")

  Dim clik As Sound
    clik = Sound.Load("pi.wav")
      clik.volume = 75
        clik.play
        resul.MoveLast
        cargar()

End

Public Sub Form_Open()
  
    
    Settings.Read(Me)
    
    Me.text = "Agenda Clientes -- " & "   " & " Ventana Principal" 

   Dim sonidointro As Sound
    sonidointro = Sound.load("int.wav")
     sonidointro.volume = 50
      sonidointro.play
       lblhora.Text = Format(dDate, "dddd dd/mm/yyyy")
        lblmetodo.Text = "Metodo"
          mod.copiarbase()
          mod.conectar()
          
          resul = mod.cnx.Exec("select * from clientes order by id Asc")
          
    If resul.Available Then
     cargar()
     Endif 
     btnguardar.Enabled = False
     

End                  

Public Sub btnfirst_Click()

  'resul = mod.cnx.Exec("select * from clientes order by id Asc")
  Dim clik As Sound
    clik = Sound.Load("pi.wav")
      clik.volume = 90
        clik.play
   resul.MoveFirst    
   cargar() 

End

Public Sub btnprevius_Click()

  Dim clik As Sound
  
  'resul = mod.cnx.Exec("select * from clientes order by id Asc")
  
    clik = Sound.Load("pi.wav")
      clik.volume = 90
        clik.play
        
    resul.MovePrevious
      If resul.Available = False Then 
         resul.MoveFirst
      Endif 
            cargar()

End

Public Sub btnnext_Click()

  Dim clik As Sound
    clik = Sound.Load("pi.wav")
      clik.volume = 90
        clik.play
         
        resul.MoveNext
        If resul.Available = False Then 
          Resul.MoveLast
        Endif
 
       cargar()
          
          

End

